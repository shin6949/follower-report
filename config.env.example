# 사용법: 이 파일을 config.env로 복사한 뒤 값을 채우세요.
#   cp config.env.example config.env

# Discord 웹훅 URL
# 얻는 곳: 채널 설정 > 연동 > 웹후크 > 새 웹후크 > "웹후크 URL 복사"
DISCORD_WEBHOOK=https://discord.com/api/webhooks/<웹훅ID>/<웹훅토큰>

# (선택) 보고를 올릴 스레드 ID (웹훅을 만든 채널에 속한 스레드여야 합니다)
# 비워 두거나 줄을 지우면 웹훅의 채널에 바로 올립니다.
# ex. DISCORD_THREAD_ID=123456789012345678
# 얻는 곳: 디스코드 설정 > 고급 > 개발자 모드 켜기 > 스레드 우클릭 > "스레드 ID 복사"
DISCORD_THREAD_ID=

# 아래 X_USER, YT_HANDLE은 둘 중 하나만 채워도 됩니다. 빈 값(또는 줄 삭제)이면 그 플랫폼은 조회하지 않습니다.
# 둘 다 비우면 실행되지 않습니다. 형식이 잘못된 항목은 건너뛰고 Discord 메시지 끝에 표시됩니다.

# 팔로워 수를 조회할 X(트위터) 계정 이름 (@ 제외). 대소문자를 구분합니다.
# ex. https://x.com/KBSnews 라면 KBSnews 삽입.
# 여러 계정은 콤마로 구분합니다. ex. X_USER=KBSnews,Other_user
X_USER=

# 구독자 수를 조회할 YouTube 채널 핸들 (@ 제외)
# ex. https://www.youtube.com/@newskbs 라면, newskbs 삽입.
# 여러 채널은 콤마로 구분합니다. ex. YT_HANDLE=newskbs,other
YT_HANDLE=
